task.spawn(function()
    task.wait(2) -- Đợi một chút khi vừa load vào game để lấy cache
    while task.wait(0.1) do 
        if Settings.AutoFarm and CustomBasePos then
            local targetObj, targetName = nil, ""
            for _, pEgg in ipairs(PriorityOrder) do
                if Settings.FarmAll or table.find(Settings.SelectedEggs, pEgg) then
                    for obj, data in pairs(ESP_Cache) do
                        if data.Name == pEgg and obj and obj.Parent then
                            targetObj = obj; targetName = pEgg; break
                        end
                    end
                end
                if targetObj then break end
            end

            if targetObj then
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local eggPos = targetObj:IsA("Model") and (targetObj.PrimaryPart and targetObj.PrimaryPart.Position or targetObj:GetPivot().Position) or targetObj:IsA("BasePart") and targetObj.Position
                    if eggPos then
                        if targetName == "Volcanic Egg" then
                            hrp.CFrame = CFrame.new(GetVolcanicSafePos(eggPos, targetObj))
                            task.wait(0.1)
                            FastTween(CFrame.new(eggPos + Vector3.new(0, 2.5, 0)))
                        else
                            hrp.CFrame = CFrame.new(eggPos + Vector3.new(0, 2.5, 0))
                            task.wait(0.15) 
                        end
                        FastInteract(targetObj) 
                        task.wait(0.05)
                        FastTween(CFrame.new(CustomBasePos + Vector3.new(0, 5, 0)))
                    end
                end
            elseif Settings.AutoHop then
                -- HOP NGAY LẬP TỨC NẾU KHÔNG CÒN TRỨNG
                HopServer() 
            end
        end
    end
end)

local HasDrawing = Drawing ~= nil
function CheckAndAddESP(obj)
    local cur = obj.Parent
    while cur and cur ~= Workspace do
        local n = string.lower(cur.Name)
        if string.find(n, "base") or string.find(n, "plot") or cur:FindFirstChild("Humanoid") then return end
        cur = cur.Parent
    end

    for exactName, color in pairs(TargetEggs) do
        if string.find(string.lower(obj.Name), string.lower(exactName)) and not ESP_Cache[obj] then
            ESP_Cache[obj] = { Name = exactName, Color = color }
            local billboard = Instance.new("BillboardGui", UI)
            billboard.Adornee = obj
            billboard.Size = UDim2.new(0, 200, 0, 50) 
            billboard.StudsOffset = Vector3.new(0, 3, 0)
            billboard.AlwaysOnTop = true
            local label = Instance.new("TextLabel", billboard)
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.TextColor3 = color
            label.TextStrokeTransparency = 1
            label.Font = Enum.Font.SourceSansBold
            label.TextSize = 16
            ESP_Cache[obj].Billboard = billboard
            ESP_Cache[obj].Label = label
            
            if HasDrawing then
                local tracer = Drawing.new("Line")
                tracer.Visible = false; tracer.Color = color; tracer.Thickness = 1.5; tracer.Transparency = 1
                ESP_Cache[obj].Line = tracer
            end
            break
        end
    end
end

Workspace.DescendantAdded:Connect(function(des) task.wait(0.05); CheckAndAddESP(des) end)
Workspace.DescendantRemoving:Connect(function(des)
    if ESP_Cache[des] then
        if ESP_Cache[des].Billboard then ESP_Cache[des].Billboard:Destroy() end
        if ESP_Cache[des].Line and HasDrawing then ESP_Cache[des].Line:Remove() end
        ESP_Cache[des] = nil
    end
end)
for _, des in ipairs(Workspace:GetDescendants()) do CheckAndAddESP(des) end

RunService.RenderStepped:Connect(function()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    for obj, data in pairs(ESP_Cache) do
        if not obj or not obj.Parent then continue end
        local ePos = obj:IsA("Model") and (obj.PrimaryPart and obj.PrimaryPart.Position or obj:GetPivot().Position) or obj:IsA("BasePart") and obj.Position
        
        if data.Label then
            data.Billboard.Enabled = Settings.ESP_Enabled
            if Settings.ESP_Enabled and hrp and ePos then 
                data.Label.Text = string.format("🥚 %s [%d stud]", data.Name, math.floor((hrp.Position - ePos).Magnitude)) 
            end
        end
        if data.Line and HasDrawing then
            if Settings.ESP_Line and ePos then
                local vector, onScreen = Camera:WorldToViewportPoint(ePos)
                if onScreen then
                    data.Line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    data.Line.To = Vector2.new(vector.X, vector.Y)
                    data.Line.Visible = true
                else data.Line.Visible = false end
            else data.Line.Visible = false end
        end
    end
end)
