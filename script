-- ============================================================
-- RETURN TO BASE
-- ============================================================
local function ReturnToBase()
    RefreshBaseIfNeeded(false)
    if not HRP or not CustomBasePos then return end

    local safeBasePos = CFrame.new(CustomBasePos + Vector3.new(0, 5, 0))

    if Settings.ReturnMode == "Teleport" then
        HRP.CFrame = safeBasePos
        return
    end

    local speed = math.max(1, tonumber(Settings.FlySpeed) or 10000)
    local distance = (HRP.Position - safeBasePos.Position).Magnitude
    local duration = math.max(0.02, distance / speed)

    TweenService:Create(
        HRP,
        TweenInfo.new(duration, Enum.EasingStyle.Linear),
        {CFrame = safeBasePos}
    ):Play()
end

-- ============================================================
-- SERVER HOP
-- ============================================================
local HopBusy = false
local LastHopAt = 0
local HopCooldown = 4

local function ServerHop()
    if HopBusy then return end
    if os.clock() - LastHopAt < HopCooldown then return end

    HopBusy = true
    LastHopAt = os.clock()
    CurrentStatus = "Hết trứng → đổi Server..."

    task.spawn(function()
        local ok, response = pcall(function()
            local api = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            return game:HttpGet(api)
        end)

        if ok and response then
            local parsedOk, data = pcall(function()
                return HttpService:JSONDecode(response)
            end)

            if parsedOk and data and data.data then
                for _, server in ipairs(data.data) do
                    if server.id ~= game.JobId and server.playing < server.maxPlayers then
                        pcall(function()
                            TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
                        end)
                        task.wait(2)
                        break
                    end
                end
            end
        end

        HopBusy = false
    end)
end

-- ============================================================
-- TARGET PICKER
-- ============================================================
local function IsValidTarget(entry)
    if not entry then return false end
    if not entry.object or not entry.object.Parent then return false end
    if not table.find(Settings.SelectedEggs, entry.eggType) then return false end
    if IsInsideOwnBase(entry.object) then return false end
    if not HasPrompt(entry.object) then return false end
    if not GetInstantPosition(entry.object) then return false end
    return true
end

local function ChooseBestTarget()
    if not HRP then return nil end

    local best
    local bestPriority = math.huge
    local bestDistance = math.huge

    for i = 1, #CandidateList do
        local entry = CandidateList[i]
        if IsValidTarget(entry) then
            local pos = GetInstantPosition(entry.object)
            local distance = (pos - HRP.Position).Magnitude
            local priority = PriorityIndex[entry.eggType] or 999

            if priority < bestPriority or (priority == bestPriority and distance < bestDistance) then
                best = entry
                bestPriority = priority
                bestDistance = distance
            end
        end
    end

    return best
end

-- ============================================================
-- TIMING / STATS
-- ============================================================
local Stats = {
    SessionEggs = 0,
    LastDetectMs = 0,
    LastApproachMs = 0,
    LastCompleteMs = 0,
    BestCompleteMs = math.huge,
    TotalCompleteMs = 0,
}

local Active = nil
local SessionEggStartedAt = nil
local ActiveStartedAt = nil

local function fmtMs(v)
    if not v or v == math.huge then return "--" end
    return string.format("%.0fms", v)
end

local function UpdateStatus(baseText)
    local session = os.clock() - ScriptStartedAt
    if Active and ActiveStartedAt then
        local liveMs = (os.clock() - ActiveStartedAt) * 1000
        StatusLbl.Text = string.format("%s | %s | S%.0fs", baseText, fmtMs(liveMs), session)
    else
        StatusLbl.Text = string.format("%s | S%.0fs", baseText, session)
    end
end

local function StartActive(entry)
    Active = {
        entry = entry,
        mode = entry.eggType == "Volcanic Egg" and "Volcanic" or "Normal",
        startedAt = os.clock(),
        lockedUntil = nil,
        tween = nil,
        fired = 0,
    }
    ActiveStartedAt = Active.startedAt
    SessionEggStartedAt = entry.firstDetectedAt or Active.startedAt

    Stats.LastDetectMs = (Active.startedAt - SessionEggStartedAt) * 1000
    CurrentStatus = "⚡ Nhận: " .. entry.eggType
end

local function FinishActive(reason)
    if not Active then return end

    local completedMs = (os.clock() - Active.startedAt) * 1000
    Stats.LastCompleteMs = completedMs
    Stats.TotalCompleteMs += completedMs
    Stats.SessionEggs += 1
    if completedMs < Stats.BestCompleteMs then
        Stats.BestCompleteMs = completedMs
    end

    if Active.tween then
        pcall(function() Active.tween:Cancel() end)
    end

    local object = Active.entry and Active.entry.object
    if object and not object.Parent then
        Candidates[object] = nil
        RemoveESP(object)
    end

    ReturnToBase()
    Active = nil
    ActiveStartedAt = nil
    SessionEggStartedAt = nil
    CurrentStatus = string.format("✅ %s | %s", reason or "xong", fmtMs(completedMs))
end

local function ProcessActive()
    if not Active then return end
    if not Settings.AutoFarm then
        FinishActive("Tắt AutoFarm")
        return
    end
    if not HRP then
        RefreshCharacter()
        return
    end

    local entry = Active.entry
    local obj = entry and entry.object
    if not obj or not obj.Parent then
        FinishActive("Trứng biến mất")
        return
    end

    if IsInsideOwnBase(obj) then
        FinishActive("Bỏ qua Base")
        return
    end

    local pos = GetInstantPosition(obj)
    if not pos then
        FinishActive("Mất tọa độ")
        return
    end

    if #entry.prompts == 0 then
        entry.prompts = GetPromptCache(obj)
    end

    local now = os.clock()

    if Active.mode == "Volcanic" then
        if not Active.tween then
            local safePos = pos + Vector3.new(0, 556.38, 0)
            HRP.CFrame = CFrame.new(safePos)
            local speed = math.max(1, tonumber(Settings.FlySpeed) or 10000)
            local duration = math.max(0.01, (safePos - (pos + Vector3.new(0, 2.5, 0))).Magnitude / speed)
            Active.tween = TweenService:Create(
                HRP,
                TweenInfo.new(duration, Enum.EasingStyle.Linear),
                {CFrame = CFrame.new(pos + Vector3.new(0, 2.5, 0))}
            )
            Active.tween:Play()
            Stats.LastApproachMs = (now - Active.startedAt) * 1000
        end

        Active.fired += FirePromptCache(entry.prompts)
        CurrentStatus = string.format("⚡ %s | %.0fms | fire:%d", entry.eggType, (now - Active.startedAt) * 1000, Active.fired)

        if not obj.Parent then
            FinishActive("Nhặt xong")
        end
    else
        if Active.lockedUntil == nil then
            Active.lockedUntil = now + 0.35
            HRP.CFrame = CFrame.new(pos + Vector3.new(0, 2.5, 0))
            Stats.LastApproachMs = (now - Active.startedAt) * 1000
        end

        if now < Active.lockedUntil and obj.Parent then
            local currentPos = GetInstantPosition(obj)
            if currentPos then
                HRP.CFrame = CFrame.new(currentPos + Vector3.new(0, 2.5, 0))
            end
            Active.fired += FirePromptCache(entry.prompts)
            CurrentStatus = string.format("⚡ %s | %.0fms | fire:%d", entry.eggType, (now - Active.startedAt) * 1000, Active.fired)
        else
            FinishActive("Hết khóa mục tiêu")
        end
    end
end

