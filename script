function CheckAndAddESP(obj)
    if not obj or not obj.Name then return end
    local name = string.lower(obj.Name)
    for exactName, color in pairs(TargetEggs) do
        if string.find(name, string.lower(exactName)) and not ESP_Cache[obj] then
            local highlight = Instance.new("Highlight")
            highlight.FillColor = color; highlight.OutlineColor = Color3.new(1, 1, 1); highlight.FillTransparency = 0.5; highlight.Enabled = Settings.ESP_Enabled; highlight.Parent = obj
            ESP_Cache[obj] = { Name = exactName, Color = color, Highlight = highlight }
            break
        end
    end
end

Workspace.DescendantAdded:Connect(function(des) 
    if des:IsA("Model") or des:IsA("BasePart") then CheckAndAddESP(des) end
end)
Workspace.DescendantRemoving:Connect(function(des) 
    if ESP_Cache[des] then if ESP_Cache[des].Highlight then ESP_Cache[des].Highlight:Destroy() end; ESP_Cache[des] = nil end 
end)
for _, des in ipairs(Workspace:GetDescendants()) do CheckAndAddESP(des) end

function NukeInteract(eggModel)
    for _, prompt in ipairs(eggModel:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            prompt.HoldDuration = 0 
            prompt.RequiresLineOfSight = false
            prompt.MaxActivationDistance = 9e9 
            if fireproximityprompt then 
                fireproximityprompt(prompt, 1)
                fireproximityprompt(prompt, 0)
                fireproximityprompt(prompt)
            end
        end
    end
end

function ServerHop()
    CurrentStatus = "Hết trứng, đang đổi Server..."
    StatusLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
    local Api = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    pcall(function()
        local response = game:HttpGet(Api)
        if response then
            local data = HttpService:JSONDecode(response)
            if data and data.data then
                for _, server in ipairs(data.data) do
                    if server.playing < server.maxPlayers and server.id ~= game.JobId then
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
                        task.wait(3)
                    end
                end
            end
        end
    end)
end

function AutoDetectBase()
    for _, folderName in ipairs({"Plots", "Ranches", "Bases", "Tycoons"}) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            for _, plot in ipairs(folder:GetChildren()) do
                local ownerVal = plot:FindFirstChild("Owner", true) or plot:FindFirstChild("Player", true)
                if ownerVal and (ownerVal.Value == LocalPlayer or ownerVal.Value == LocalPlayer.Name) then
                    local dest = plot:FindFirstChild("Floor", true) or plot:FindFirstChildWhichIsA("BasePart", true)
                    if dest then return dest.Position end
                end
            end
        end
    end
    return Vector3.new(0, 50, 0)
end

function IsValid(obj)
    return obj and obj.Parent and obj:IsDescendantOf(Workspace)
end

-- =========================================
-- VÒNG LẶP CHÍNH (QUAY VỀ BASE SAU KHI LẤY)
-- =========================================
task.spawn(function()
    while true do
        RunService.Heartbeat:Wait() 
        StatusLbl.Text = CurrentStatus
        
        if Settings.AutoFarm then
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local targetObj, targetName = nil, ""
                for _, pEgg in ipairs(PriorityOrder) do
                    if table.find(Settings.SelectedEggs, pEgg) then
                        for obj, data in pairs(ESP_Cache) do
                            if data.Name == pEgg and IsValid(obj) then 
                                targetObj = obj; targetName = pEgg; break 
                            end
                        end
                    end
                    if targetObj then break end
                end

                if targetObj then
                    CurrentStatus = "Đang cướp: " .. targetName
                    StatusLbl.TextColor3 = TargetEggs[targetName] or Color3.fromRGB(255, 255, 0)
                    
                    local eggPos = targetObj:IsA("Model") and (targetObj.PrimaryPart and targetObj.PrimaryPart.Position or targetObj:GetPivot().Position) or targetObj:IsA("BasePart") and targetObj.Position
                    
                    if eggPos then
                        if targetName == "Volcanic Egg" then
                            local peakPos = eggPos + Vector3.new(0, 556.38, 0)
                            local dropPos = eggPos + Vector3.new(0, 2, 0)
                            
                            -- Bay lên đỉnh
                            hrp.CFrame = CFrame.new(peakPos)
                            RunService.RenderStepped:Wait()
                            
                            -- Rơi siêu tốc bằng Lerp (5 frame)
                            for i = 1, 6 do
                                if not IsValid(targetObj) then break end
                                hrp.CFrame = CFrame.new(peakPos):Lerp(CFrame.new(dropPos), i/6)
                                NukeInteract(targetObj)
                                RunService.RenderStepped:Wait()
                            end
                            
                            -- Ép nhặt
                            local timeout = tick() + 0.5 
                            while IsValid(targetObj) and tick() < timeout do
                                hrp.CFrame = CFrame.new(dropPos)
                                NukeInteract(targetObj)
                                RunService.Heartbeat:Wait()
                            end
                        else
                            -- Trứng thường
                            local dropPos = eggPos + Vector3.new(0, 1.5, 0)
                            local timeout = tick() + 0.5 
                            
                            while IsValid(targetObj) and tick() < timeout do
                                hrp.CFrame = CFrame.new(dropPos)
                                NukeInteract(targetObj)
                                RunService.Heartbeat:Wait()
                            end
                        end
                        
                        -- LẤY XONG -> QUAY VỀ BASE TRƯỚC KHI TÌM QUẢ TIẾP THEO
                        CurrentStatus = "Về Base..."
                        ReturnToBase(hrp)
                        task.wait(0.1) -- Đợi 0.1s ở Base để Server ổn định chống Anti-Cheat
                    end
                else
                    if Settings.AutoHop and #Settings.SelectedEggs > 0 then
                        ServerHop(); task.wait(5)
                    else
                        CurrentStatus = "Đang rình trứng..."
                        StatusLbl.TextColor3 = Color3.fromRGB(150, 150, 150)
                        -- Nấp ở Base
                        ReturnToBase(hrp)
                        task.wait(0.5)
                    end
                end
            end
        else
            CurrentStatus = "Đang nhàn rỗi (OFF)"
            StatusLbl.TextColor3 = Color3.fromRGB(150, 150, 150)
        end
    end
end)
