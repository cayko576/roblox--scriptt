-- ============================================================
-- BASE DETECTION + BOUNDS
-- ============================================================
local CustomBasePos = nil
local OwnedBaseRoot = nil
local BaseBoundsCF = nil
local BaseBoundsSize = nil
local BaseMargin = 3
local NextBaseRefresh = 0

local function valueMatchesPlayer(valueObject)
    if not valueObject then return false end

    local ok, value = pcall(function()
        return valueObject.Value
    end)
    if not ok then return false end

    if value == LocalPlayer then return true end
    if typeof(value) == "Instance" and value:IsA("Player") and value == LocalPlayer then return true end
    if type(value) == "string" and normalize(value) == normalize(LocalPlayer.Name) then return true end
    if type(value) == "number" and value == LocalPlayer.UserId then return true end

    return false
end

local function findOwnerValue(container)
    for _, name in ipairs({"Owner", "Player", "OwnerValue", "ClaimedBy", "UserId", "UserID"}) do
        local v = container:FindFirstChild(name, true)
        if v and valueMatchesPlayer(v) then
            return v
        end
    end
    return nil
end

local function updateBaseBounds(root)
    if not root then
        BaseBoundsCF = nil
        BaseBoundsSize = nil
        return
    end

    local ok, cf, size = pcall(function()
        if root:IsA("Model") then
            return root:GetBoundingBox()
        elseif root:IsA("BasePart") then
            return root.CFrame, root.Size
        end
        return nil, nil
    end)

    if ok and cf and size then
        BaseBoundsCF = cf
        BaseBoundsSize = size
    end
end

local function DetectOwnedBase()
    local searchFolders = {"Plots", "Ranches", "Bases", "Tycoons", "Islands", "Estates"}

    for _, folderName in ipairs(searchFolders) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            for _, candidate in ipairs(folder:GetChildren()) do
                local owner = findOwnerValue(candidate)
                if owner then
                    local dest = candidate:FindFirstChild("Floor", true)
                        or candidate:FindFirstChild("Spawn", true)
                        or candidate:FindFirstChildWhichIsA("BasePart", true)

                    local pos = dest and dest.Position
                    if not pos and candidate:IsA("Model") then
                        local ok, cf = pcall(function()
                            return candidate:GetPivot()
                        end)
                        if ok and cf then pos = cf.Position end
                    end

                    if pos then
                        return candidate, pos
                    end
                end
            end
        end
    end

    return nil, nil
end

local function AutoDetectBase()
    local root, pos = DetectOwnedBase()
    if root then
        OwnedBaseRoot = root
        CustomBasePos = pos
        updateBaseBounds(root)
        return pos
    end

    return nil
end

local function RefreshBaseIfNeeded(force)
    local now = os.clock()
    if not force and now < NextBaseRefresh then return end
    NextBaseRefresh = now + 5

    local pos = AutoDetectBase()
    if not pos then
        OwnedBaseRoot = nil
        CustomBasePos = nil
        BaseBoundsCF = nil
        BaseBoundsSize = nil
    end
end

RefreshBaseIfNeeded(true)

task.spawn(function()
    while task.wait(5) do
        RefreshBaseIfNeeded(true)
    end
end)

local function PointInsideBase(pos)
    if not BaseBoundsCF or not BaseBoundsSize then return false end
    local localPos = BaseBoundsCF:PointToObjectSpace(pos)
    return math.abs(localPos.X) <= (BaseBoundsSize.X * 0.5 + BaseMargin)
        and math.abs(localPos.Y) <= (BaseBoundsSize.Y * 0.5 + BaseMargin)
        and math.abs(localPos.Z) <= (BaseBoundsSize.Z * 0.5 + BaseMargin)
end

local function IsDescendantOfOwnedBase(obj)
    if not obj or not OwnedBaseRoot then return false end
    local cursor = obj
    for _ = 1, 20 do
        if cursor == OwnedBaseRoot then return true end
        cursor = cursor.Parent
        if not cursor then break end
    end
    return false
end

local function IsInsideOwnBase(obj)
    if not obj or not obj.Parent then return true end
    if IsDescendantOfOwnedBase(obj) then return true end

    local pos
    local ok, result = pcall(function()
        if obj:IsA("BasePart") then
            return obj.Position
        elseif obj:IsA("Model") then
            return obj:GetPivot().Position
        end
        return nil
    end)
    if ok then pos = result end

    return pos and PointInsideBase(pos) or false
end

