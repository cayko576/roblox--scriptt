local function CreateTab(name, isFirst)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1/3, 0, 1, 0)
    btn.BackgroundColor3 = isFirst and Color3.fromRGB(50, 150, 255) or Color3.fromRGB(30, 30, 35)
