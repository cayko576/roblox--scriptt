-- HỆ THỐNG FLY TỐC ĐỘ (DÙNG CHO MODE FLY)
-- =========================================
local CurrentTween = nil
function FastTween(targetCFrame)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local dist = (hrp.Position - targetCFrame.Position).Magnitude
    local timeToTravel = math.max(0.02, dist / Settings.FlySpeed)
    
    if CurrentTween then CurrentTween:Cancel() end
    CurrentTween = TweenService:Create(hrp, TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    CurrentTween:Play()
    CurrentTween.Completed:Wait()
end

function ReturnToBase(hrp)
    if not CustomBasePos then CustomBasePos = AutoDetectBase() end
    if CustomBasePos and hrp then
        local targetCFrame = CFrame.new(CustomBasePos + Vector3.new(0, 5, 0))
        if Settings.ReturnMode == "Teleport" then
            hrp.CFrame = targetCFrame
        else
            FastTween(targetCFrame)
        end
    end
end

