                            Rayfield:Notify({Title = "AUTO HOP", Content = "Đang chuyển Server siêu tốc...", Duration = 1.5})
                            task.wait(1)
                            HopServer()
                        end
                    end
                end
            elseif Settings.AutoHop then
                HopServer()
            end
        end
    end
end)

