local function CreateToggle(text, defaultState, callback)
    local btn = Instance.new("TextButton", ScrollFrame)
    local cOn, cOff = Color3.fromRGB(40, 140, 60), Color3.fromRGB(40, 40, 45)
    btn.BackgroundColor3 = defaultState and cOn or cOff
    btn.Text = (defaultState and "✅ " or "❌ ") .. text
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 11
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    local state = defaultState
    btn.MouseButton1Click:Connect(function()
        state = not state
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = state and cOn or cOff}):Play()
        btn.Text = (state and "✅ " or "❌ ") .. text
        callback(state)
        SaveSettings()
    end)
    return btn
end

