local NextThinkAt = 0
local ThinkInterval = 0.05

RunService.Heartbeat:Connect(function()
    local now = os.clock()

    if now >= NextThinkAt then
        NextThinkAt = now + ThinkInterval
        CleanupCandidates()

        if Settings.AutoFarm and not Active then
            RefreshBaseIfNeeded(false)
            local target = ChooseBestTarget()
            if target then
                StartActive(target)
            elseif #Settings.SelectedEggs == 0 then
                CurrentStatus = "Chưa chọn trứng"
            else
                UpdateStatus("Đang rình trứng")
            end
        end
    end

    ProcessActive()
end)

