function ServerHop()
    CurrentStatus = "Hết trứng, đang đổi Server..."
    local Api = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    pcall(function() local response = game:HttpGet(Api); if response then local data = HttpService:JSONDecode(response); if data and data.data then for _, server in ipairs(data.data) do if server.playing < server.maxPlayers and server.id ~= game.JobId then TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer); task.wait(3) end end end end end)
end

function AutoDetectBase()
    for _, folderName in ipairs({"Plots", "Ranches", "Bases", "Tycoons"}) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then for _, plot in ipairs(folder:GetChildren()) do local ownerVal = plot:FindFirstChild("Owner", true) or plot:FindFirstChild("Player", true); if ownerVal and (ownerVal.Value == LocalPlayer or ownerVal.Value == LocalPlayer.Name) then local dest = plot:FindFirstChild("Floor", true) or plot:FindFirstChildWhichIsA("BasePart", true); if dest then return dest.Position end end end end
    end
    return nil
end

function ReturnToBase()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp and CustomBasePos then
        local safeBasePos = CFrame.new(CustomBasePos + Vector3.new(0, 5, 0))
        if Settings.ReturnMode == "Teleport" then hrp.CFrame = safeBasePos else TweenService:Create(hrp, TweenInfo.new(math.max(0.02, (hrp.Position - safeBasePos.Position).Magnitude / Settings.FlySpeed), Enum.EasingStyle.Linear), {CFrame = safeBasePos}):Play() end
    end
end

task.spawn(function() while task.wait(5) do if not CustomBasePos then CustomBasePos = AutoDetectBase() end end end)

-- =========================================
-- HỆ THỐNG XỬ LÝ EGG VƯỢT GIỚI HẠN (SUPREME SPEED)
-- =========================================

local function FireAllPrompts(obj)
    for _, prompt in ipairs(obj:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            prompt.RequiresLineOfSight = false
            prompt.MaxActivationDistance = 9999
            if fireproximityprompt then
                fireproximityprompt(prompt, 0); fireproximityprompt(prompt, 1); fireproximityprompt(prompt)
            end
        end
    end
end

-- Hàm lấy tọa độ KHÔNG ĐỘ TRỄ (Bỏ qua PrimaryPart)
local function GetInstantPosition(obj)
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart.Position end
        local childPart = obj:FindFirstChildWhichIsA("BasePart", true)
        if childPart then return childPart.Position end
        local pivot = obj:GetPivot()
        if pivot then return pivot.Position end
    end
    return nil
end

Workspace.DescendantAdded:Connect(function(obj)
    if not Settings.AutoFarm then return end
    
    local targetEggType = nil
    for _, pEgg in ipairs(Settings.SelectedEggs) do
        if string.find(string.lower(obj.Name), string.lower(pEgg)) then
            targetEggType = pEgg
            break
        end
    end

    if targetEggType then
        task.spawn(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            -- Kéo tọa độ bằng mọi giá trong vòng 0.1 giây (Tránh treo vòng lặp)
            local eggPos = nil
            for i = 1, 15 do -- Quét siêu nhanh khoảng 15 khung hình thay vì đợi giây
                eggPos = GetInstantPosition(obj)
                if eggPos then break end
                RunService.RenderStepped:Wait()
            end
            
            if not eggPos then return end

            CurrentStatus = "⚡ TỐC BIẾN: " .. targetEggType

            if targetEggType == "Volcanic Egg" then
                -- Volcanic: Dịch chuyển lên không trung và bay xuống
                local safePos = eggPos + Vector3.new(0, 556.38, 0)
                hrp.CFrame = CFrame.new(safePos)
                local twn = TweenService:Create(hrp, TweenInfo.new(math.max(0.01, (hrp.Position - (eggPos + Vector3.new(0, 2.5, 0))).Magnitude / Settings.FlySpeed), Enum.EasingStyle.Linear), {CFrame = CFrame.new(eggPos + Vector3.new(0, 2.5, 0))})
                twn:Play()
                
                local conn
                conn = RunService.RenderStepped:Connect(function()
                    if obj and obj.Parent then 
                        FireAllPrompts(obj) 
                    else 
                        twn:Cancel()
                        if conn then conn:Disconnect() end
                        ReturnToBase()
                    end
                end)
            else
                -- TRỨNG THƯỜNG: Dịch chuyển ngay lập tức và Khóa CFrame
                local endTime = tick() + 0.35 -- Khóa mục tiêu 0.35 giây
                local conn
                conn = RunService.RenderStepped:Connect(function()
                    if obj and obj.Parent and tick() < endTime then
                        -- Khóa chặt nhân vật ở tọa độ trứng mỗi khung hình để chống giật/lag
                        local currentEggPos = GetInstantPosition(obj)
                        if currentEggPos then
                            hrp.CFrame = CFrame.new(currentEggPos + Vector3.new(0, 2.5, 0))
                        end
                        FireAllPrompts(obj)
                    else
                        if conn then conn:Disconnect() end
                        ReturnToBase()
                    end
                end)
            end
        end)
    end
end)

