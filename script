    btn.MouseButton1Click:Connect(function()
        for _, t in ipairs(Tabs) do t.Page.Visible = false; t.Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 35) end
        page.Visible = true; btn.BackgroundColor3 = Color3.fromRGB(50, 150, 255)
    end)
    return page
end

local function CreateToggle(parent, text, defaultState, callback)
    local btn = Instance.new("TextButton")
    btn.BackgroundColor3 = defaultState and Color3.fromRGB(40, 160, 70) or Color3.fromRGB(45, 45, 50)
    btn.Text = (defaultState and "ON | " or "OFF | ") .. text
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 12
    btn.BorderSizePixel = 0
    btn.Parent = parent
    
    local state = defaultState
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.BackgroundColor3 = state and Color3.fromRGB(40, 160, 70) or Color3.fromRGB(45, 45, 50)
        btn.Text = (state and "ON | " or "OFF | ") .. text
        callback(state); SaveSettings()
    end)
end

local function CreateEggToggle(parent, eggName)
    local isSelected = table.find(Settings.SelectedEggs, eggName) ~= nil
    local btn = Instance.new("TextButton")
    -- Đổi thành Xanh Lá khi được chọn, Xám khi bỏ chọn
    btn.BackgroundColor3 = isSelected and Color3.fromRGB(40, 160, 70) or Color3.fromRGB(45, 45, 50)
    btn.Text = (isSelected and "ĐANG TÌM: " or "CHỌN: ") .. eggName
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 12
    btn.BorderSizePixel = 0
    btn.Parent = parent
    
    btn.MouseButton1Click:Connect(function()
        local idx = table.find(Settings.SelectedEggs, eggName)
        if idx then
            table.remove(Settings.SelectedEggs, idx)
            isSelected = false
        else
            table.insert(Settings.SelectedEggs, eggName)
            isSelected = true
        end
        btn.BackgroundColor3 = isSelected and Color3.fromRGB(40, 160, 70) or Color3.fromRGB(45, 45, 50)
        btn.Text = (isSelected and "ĐANG TÌM: " or "CHỌN: ") .. eggName
        SaveSettings()
    end)
end

