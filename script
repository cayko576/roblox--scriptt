-- NHẬN DIỆN ESP & LINE TRACER
-- =========================================
function CheckAndAddESP(obj)
    local cur = obj.Parent
    while cur and cur ~= Workspace do
        local n = string.lower(cur.Name)
        if string.find(n, "base") or string.find(n, "plot") or cur:FindFirstChild("Humanoid") then return end
        cur = cur.Parent
    end
    for exactName, color in pairs(TargetEggs) do
        if string.find(string.lower(obj.Name), string.lower(exactName)) and not ESP_Cache[obj] then
            local highlight = Instance.new("Highlight")
            highlight.FillColor = color; highlight.OutlineColor = Color3.new(1, 1, 1); highlight.FillTransparency = 0.5; highlight.Enabled = Settings.ESP_Enabled; highlight.Parent = obj
            
            local line = Drawing.new("Line")
            line.Color = color
            line.Thickness = 1.5
            line.Transparency = 1
            line.Visible = false
            
            ESP_Cache[obj] = { Name = exactName, Color = color, Highlight = highlight, Line = line }; break
        end
    end
end
Workspace.DescendantAdded:Connect(function(des) CheckAndAddESP(des) end) -- Đã xóa task.wait(0.05)
Workspace.DescendantRemoving:Connect(function(des) 
    if ESP_Cache[des] then 
        if ESP_Cache[des].Highlight then ESP_Cache[des].Highlight:Destroy() end
        if ESP_Cache[des].Line then ESP_Cache[des].Line:Remove() end
        ESP_Cache[des] = nil 
    end 
end)
for _, des in ipairs(Workspace:GetDescendants()) do CheckAndAddESP(des) end

