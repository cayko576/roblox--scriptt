function ServerHop()
    CurrentStatus = "Hết trứng, đang đổi Server..."
    StatusLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
    local Api = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    pcall(function()
        local response = game:HttpGet(Api)
        if response then
            local data = HttpService:JSONDecode(response)
            if data and data.data then
                for _, server in ipairs(data.data) do
                    if server.playing < server.maxPlayers and server.id ~= game.JobId then
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
                        task.wait(3)
                    end
                end
            end
        end
    end)
end

function AutoDetectBase()
    for _, folderName in ipairs({"Plots", "Ranches", "Bases", "Tycoons"}) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            for _, plot in ipairs(folder:GetChildren()) do
                local ownerVal = plot:FindFirstChild("Owner", true) or plot:FindFirstChild("Player", true)
                if ownerVal and (ownerVal.Value == LocalPlayer or ownerVal.Value == LocalPlayer.Name) then
                    local dest = plot:FindFirstChild("Floor", true) or plot:FindFirstChildWhichIsA("BasePart", true)
                    if dest then return dest.Position end
                end
            end
        end
    end
    return nil
end

local CurrentTween = nil
function FastTween(targetCFrame)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local dist = (hrp.Position - targetCFrame.Position).Magnitude
    local timeToTravel = math.max(0.02, dist / Settings.FlySpeed)
    
    if CurrentTween then CurrentTween:Cancel() end
    CurrentTween = TweenService:Create(hrp, TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    CurrentTween:Play()
    CurrentTween.Completed:Wait()
end

function ReturnToBase()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp and CustomBasePos then
        local safeBasePos = CFrame.new(CustomBasePos + Vector3.new(0, 5, 0))
        if Settings.ReturnMode == "Teleport" then
            hrp.CFrame = safeBasePos
        else
            FastTween(safeBasePos)
        end
    end
end

-- Kích hoạt tất cả prompt trong tích tắc
function UltraFastInteract(eggModel)
    for _, prompt in ipairs(eggModel:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            prompt.HoldDuration = 0 
            prompt.RequiresLineOfSight = false
            prompt.MaxActivationDistance = 100 
            
            if fireproximityprompt then 
                fireproximityprompt(prompt, 0)
                fireproximityprompt(prompt, 1)
                fireproximityprompt(prompt)
            end
            pcall(function() prompt:InputHoldBegin() end)
            pcall(function() prompt:InputHoldEnd() end)
        end
    end
end

function GetVolcanicSafePos(eggPos)
    return eggPos + Vector3.new(0, 556.38, 0)
end

task.spawn(function()
    while task.wait() do 
        if Settings.AutoFarm then
            if not CustomBasePos then CustomBasePos = AutoDetectBase() or Vector3.new(0, 50, 0) end
            local targetObj, targetName = nil, ""
            
            for _, pEgg in ipairs(PriorityOrder) do
                if table.find(Settings.SelectedEggs, pEgg) then
                    for obj, data in pairs(ESP_Cache) do
                        if data.Name == pEgg then
                            if IsEggValid(obj) then targetObj = obj; targetName = pEgg; break
                            else 
                                if data.Highlight then data.Highlight:Destroy() end
                                if data.Line then data.Line:Remove() end
                                ESP_Cache[obj] = nil 
                            end
                        end
                    end
                end
                if targetObj then break end
            end

            if targetObj then
                CurrentStatus = "Đang lấy: " .. targetName
                StatusLbl.TextColor3 = TargetEggs[targetName] or Color3.fromRGB(255, 255, 0)

                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local eggPos = targetObj:IsA("Model") and (targetObj.PrimaryPart and targetObj.PrimaryPart.Position or targetObj:GetPivot().Position) or targetObj:IsA("BasePart") and targetObj.Position
                    if eggPos then
                        if targetName == "Volcanic Egg" then
                            -- Volcanic: Dịch chuyển chuẩn lên đỉnh (0ms delay) -> Tween xuống và tương tác liên tục
                            hrp.CFrame = CFrame.new(GetVolcanicSafePos(eggPos))
                            
                            local twn = TweenService:Create(hrp, TweenInfo.new(math.max(0.02, (hrp.Position - (eggPos + Vector3.new(0, 2.5, 0))).Magnitude / Settings.FlySpeed), Enum.EasingStyle.Linear), {CFrame = CFrame.new(eggPos + Vector3.new(0, 2.5, 0))})
                            twn:Play()
                            
                            -- Spam kích hoạt trong lúc rớt xuống. Hủy ngay khi ăn được trứng.
                            while twn.PlaybackState == Enum.PlaybackState.Playing do
                                if not IsEggValid(targetObj) then break end
                                UltraFastInteract(targetObj)
                                task.wait() 
                            end
                            
                            if twn.PlaybackState == Enum.PlaybackState.Playing then twn:Cancel() end
                            ReturnToBase()
                        else
                            -- Các trứng thường: Dịch chuyển và tương tác ngay trong CÙNG MỘT KHUNG HÌNH (0ms)
                            hrp.CFrame = CFrame.new(eggPos + Vector3.new(0, 2.5, 0))
                            UltraFastInteract(targetObj)
                            
                            -- Quét siêu tốc (tối đa 0.3s) để đảm bảo server đã ghi nhận, hủy ngay khi trứng biến mất
                            local timeout = tick() + 0.3
                            while IsEggValid(targetObj) and tick() < timeout do 
                                UltraFastInteract(targetObj)
                                task.wait()
                            end
                            
                            ReturnToBase()
                        end
                    end
                end
            else
                if Settings.AutoHop and #Settings.SelectedEggs > 0 then
                    task.wait(2)
                    local anyEggLeft = false
                    for obj, data in pairs(ESP_Cache) do
                        if table.find(Settings.SelectedEggs, data.Name) and IsEggValid(obj) then anyEggLeft = true; break end
                    end
                    if not anyEggLeft then ServerHop(); task.wait(5) end
                else
                    CurrentStatus = "Đợi trứng spawn..."
                    StatusLbl.TextColor3 = Color3.fromRGB(150, 150, 150)
                end
            end
        else
            CurrentStatus = "Đang nhàn rỗi (AutoFarm OFF)"
            StatusLbl.TextColor3 = Color3.fromRGB(150, 150, 150)
        end
    end
end)
