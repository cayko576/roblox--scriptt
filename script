}

local TargetEggs = {
    ["Volcanic Egg"] = Color3.fromRGB(255, 50, 50),
    ["Cherub Egg"] = Color3.fromRGB(255, 215, 0),
    ["Solaris Egg"] = Color3.fromRGB(255, 140, 0),
    ["Blackhole Egg"] = Color3.fromRGB(180, 80, 255),
}

local PriorityIndex = {}
for i, eggName in ipairs(PriorityOrder) do
    PriorityIndex[eggName] = i
end

local function normalize(s)
    return string.lower(tostring(s or ""))
end

local function selectedEggTypeFromName(name)
    local lowerName = normalize(name)
    local bestType, bestPriority

    for eggName, _ in pairs(TargetEggs) do
        if table.find(Settings.SelectedEggs, eggName) then
            local a, b = lowerName, normalize(eggName)
            if string.find(a, b, 1, true) then
                local p = PriorityIndex[eggName] or 999
                if not bestPriority or p < bestPriority then
                    bestType, bestPriority = eggName, p
                end
            end
        end
    end

    return bestType
end

