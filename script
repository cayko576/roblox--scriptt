local function SaveSettings()
    if writefile then pcall(function() writefile(ConfigFile, HttpService:JSONEncode(Settings)) end) end
end
local function LoadSettings()
    if readfile and isfile and isfile(ConfigFile) then
        pcall(function()
            local decoded = HttpService:JSONDecode(readfile(ConfigFile))
            for k, v in pairs(decoded) do Settings[k] = v end
        end)
    end
end
LoadSettings()

local function GetVisitedServers()
    if readfile and isfile and isfile(VisitedFile) then
        local s, r = pcall(function() return HttpService:JSONDecode(readfile(VisitedFile)) end)
        if s and type(r) == "table" then return r end
    end
    return {}
end
local function AddVisitedServer(jobId)
    local list = GetVisitedServers()
    table.insert(list, jobId)
    if #list > 100 then table.remove(list, 1) end 
    if writefile then pcall(function() writefile(VisitedFile, HttpService:JSONEncode(list)) end) end
end

