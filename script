function CheckAndAddESP(obj)
    local cur = obj.Parent
    while cur and cur ~= Workspace do
        local n = string.lower(cur.Name)
        if string.find(n, "base") or string.find(n, "plot") or cur:FindFirstChild("Humanoid") then return end
        cur = cur.Parent
    end
    for exactName, color in pairs(TargetEggs) do
        if string.find(string.lower(obj.Name), string.lower(exactName)) and not ESP_Cache[obj] then
            ESP_Cache[obj] = { Name = exactName, Color = color }
            break
        end
    end
end
Workspace.DescendantAdded:Connect(function(des) task.wait(0.05); CheckAndAddESP(des) end)
Workspace.DescendantRemoving:Connect(function(des) if ESP_Cache[des] then ESP_Cache[des] = nil end end)
for _, des in ipairs(Workspace:GetDescendants()) do CheckAndAddESP(des) end

