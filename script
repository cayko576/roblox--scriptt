local ESP_Cache = {}

local function RemoveESP(obj)
    local data = ESP_Cache[obj]
    if data then
        if data.Highlight then data.Highlight:Destroy() end
        if data.Billboard then data.Billboard:Destroy() end
        ESP_Cache[obj] = nil
    end
end

local function EnsureESP(obj, eggType)
    if not Settings.ESP_Enabled then return end
    if not obj or not obj.Parent or IsInsideOwnBase(obj) then return end

    local data = ESP_Cache[obj]
    if data and data.Highlight and data.Billboard then
        data.Highlight.Enabled = true
        data.Billboard.Enabled = true
        return
    end

    local adornee = obj
    if not (adornee:IsA("Model") or adornee:IsA("BasePart")) then
        adornee = obj:FindFirstChildWhichIsA("BasePart", true)
    end
    if not adornee then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "VIP_Egg_Highlight"
    highlight.Adornee = adornee
    highlight.FillTransparency = 0.65
    highlight.OutlineTransparency = 0.1
    highlight.FillColor = TargetEggs[eggType] or Color3.new(1, 1, 1)
    highlight.Parent = UI

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "VIP_Egg_Billboard"
    billboard.Size = UDim2.fromOffset(150, 28)
    billboard.AlwaysOnTop = true
    billboard.Enabled = true
    billboard.Adornee = adornee
    billboard.Parent = UI

    local label = Instance.new("TextLabel", billboard)
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = eggType
    label.TextColor3 = TargetEggs[eggType] or Color3.new(1, 1, 1)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.TextStrokeTransparency = 0.5

    ESP_Cache[obj] = {
        Highlight = highlight,
        Billboard = billboard,
    }
end

-- ============================================================
-- PROMPT CACHE
-- ============================================================
local function GetPromptCache(obj)
    if not obj then return {} end

    local prompts = {}
    for _, child in ipairs(obj:GetDescendants()) do
        if child:IsA("ProximityPrompt") then
            prompts[#prompts + 1] = child
            pcall(function()
                child.RequiresLineOfSight = false
                child.MaxActivationDistance = 9999
            end)
        end
    end
    return prompts
end

local function FirePrompt(prompt)
    if not prompt or not prompt.Parent then return false end
    if not fireproximityprompt then return false end

    local fired = false
    pcall(function() fireproximityprompt(prompt, 0) fired = true end)
    pcall(function() fireproximityprompt(prompt, 1) fired = true end)
    pcall(function() fireproximityprompt(prompt) fired = true end)
    return fired
end

local function FirePromptCache(prompts)
    local count = 0
    for i = #prompts, 1, -1 do
        local prompt = prompts[i]
        if not prompt or not prompt.Parent then
            table.remove(prompts, i)
        else
            if FirePrompt(prompt) then count += 1 end
        end
    end
    return count
end

-- ============================================================
-- TARGET REGISTRY
-- ============================================================
local Candidates = {}
local CandidateList = {}
local LastRegistryCleanup = 0

local function GetInstantPosition(obj)
    if not obj then return nil end

    if obj:IsA("BasePart") then
        return obj.Position
    end

    if obj:IsA("Model") then
        local ok, pivot = pcall(function() return obj:GetPivot() end)
        if ok and pivot then
            return pivot.Position
        end

        local primary = obj.PrimaryPart
        if primary then
            return primary.Position
        end

        local childPart = obj:FindFirstChildWhichIsA("BasePart", true)
        if childPart then
            return childPart.Position
        end
    end

    return nil
end

local function FindEggAncestor(obj)
    local cursor = obj
    for _ = 1, 10 do
        if cursor and cursor ~= Workspace then
            local eggType = selectedEggTypeFromName(cursor.Name)
            if eggType then
                return cursor, eggType
            end
            cursor = cursor.Parent
        else
            break
        end
    end
    return nil, nil
end

local function HasPrompt(obj)
    if not obj then return false end
    if obj:IsA("ProximityPrompt") then return true end
    return obj:FindFirstChildWhichIsA("ProximityPrompt", true) ~= nil
end

local function RegisterCandidate(obj, forcedType)
    if not obj or not obj.Parent then return end

    local eggObj, eggType = FindEggAncestor(obj)
    eggObj = eggObj or obj
    eggType = forcedType or eggType
    if not eggType then return end

    if IsInsideOwnBase(eggObj) then
        RemoveESP(eggObj)
        return
    end

    local pos = GetInstantPosition(eggObj)
    if not pos then return end
    if not HasPrompt(eggObj) then return end

    local existing = Candidates[eggObj]
    if existing then
        existing.eggType = eggType
        existing.lastSeen = os.clock()
        return
    end

    local entry = {
        object = eggObj,
        eggType = eggType,
        prompts = GetPromptCache(eggObj),
        spawnedAt = os.clock(),
        firstDetectedAt = os.clock(),
        lastSeen = os.clock(),
    }

    Candidates[eggObj] = entry
    CandidateList[#CandidateList + 1] = entry
    EnsureESP(eggObj, eggType)
end

local function UnregisterCandidate(obj)
    Candidates[obj] = nil
    RemoveESP(obj)
end

local function CleanupCandidates()
    if os.clock() - LastRegistryCleanup < 1 then return end
    LastRegistryCleanup = os.clock()

    for i = #CandidateList, 1, -1 do
        local entry = CandidateList[i]
        local obj = entry.object
        if not obj or not obj.Parent or Candidates[obj] ~= entry then
            table.remove(CandidateList, i)
            RemoveESP(obj)
        elseif IsInsideOwnBase(obj) then
            Candidates[obj] = nil
            table.remove(CandidateList, i)
            RemoveESP(obj)
        else
            entry.lastSeen = os.clock()
            if #entry.prompts == 0 then
                entry.prompts = GetPromptCache(obj)
            end
        end
    end
end

local function InitialEggScan()
    local descendants = Workspace:GetDescendants()
    for i = 1, #descendants do
        local obj = descendants[i]
        local eggObj, eggType = FindEggAncestor(obj)
        if eggObj and eggType then
            RegisterCandidate(eggObj, eggType)
        end
    end
end

Workspace.DescendantAdded:Connect(function(obj)
    if not Settings.AutoFarm and not Settings.ESP_Enabled then
        return
    end

    task.defer(function()
        if not obj or not obj.Parent then return end
        local eggObj, eggType = FindEggAncestor(obj)
        if eggObj and eggType then
            RegisterCandidate(eggObj, eggType)
        end
    end)
end)

Workspace.DescendantRemoving:Connect(function(obj)
    if Candidates[obj] then
        UnregisterCandidate(obj)
    end
end)

