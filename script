local isHopping = false 
local function HopServer()
    if isHopping then return end
    isHopping = true
    CurrentStatus = "Đang Hop Server..."
    StatusLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
    
    AddVisitedServer(game.JobId)
    local visitedList = GetVisitedServers()
    local visitedMap = {}
    for _, id in ipairs(visitedList) do visitedMap[id] = true end

    local queue = queue_on_teleport or syn and syn.queue_on_teleport or fluxus and fluxus.queue_on_teleport
    if queue then pcall(function() queue([[task.wait(2)]]) end) end

    local req = request or http_request or (syn and syn.request) or (http and http.request)
    local hopped = false
    
    if req then
        local success, res = pcall(function()
            return req({Url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&excludeFullGames=true&limit=100", Method = "GET"})
        end)
        if success and res.Body then
            local data = HttpService:JSONDecode(res.Body)
            if data and data.data then
                local validServers = {}
                for _, server in ipairs(data.data) do
                    if type(server) == "table" and server.playing < server.maxPlayers - 1 and not visitedMap[server.id] then
                        table.insert(validServers, server.id)
                    end
                end
                if #validServers > 0 then
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, validServers[math.random(1, #validServers)], LocalPlayer)
                    hopped = true
                end
            end
        end
    end
    if not hopped then TeleportService:Teleport(game.PlaceId, LocalPlayer) end
    task.wait(5)
    isHopping = false
end

function AutoDetectBase()
    for _, folderName in ipairs({"Plots", "Ranches", "Bases", "Tycoons"}) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            for _, plot in ipairs(folder:GetChildren()) do
                local ownerVal = plot:FindFirstChild("Owner", true) or plot:FindFirstChild("Player", true)
                if ownerVal and (ownerVal.Value == LocalPlayer or ownerVal.Value == LocalPlayer.Name) then
                    local dest = plot:FindFirstChild("Floor", true) or plot:FindFirstChildWhichIsA("BasePart", true)
                    if dest then return dest.Position end
                end
            end
        end
    end
    return nil
end

local CurrentTween = nil
function FastTween(targetCFrame)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local dist = (hrp.Position - targetCFrame.Position).Magnitude
    local timeToTravel = math.max(0.02, dist / Settings.FlySpeed)
    
    if CurrentTween then CurrentTween:Cancel() end
    CurrentTween = TweenService:Create(hrp, TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    CurrentTween:Play()
    CurrentTween.Completed:Wait()
end

-- TỐI ƯU HÓA HÀM TƯƠNG TÁC (TỐC ĐỘ BÀN PHÍM)
function FastInteract(eggModel)
    local prompt = eggModel:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        prompt.HoldDuration = 0 
        prompt.RequiresLineOfSight = false
        
        if fireproximityprompt then 
            -- Đa tín hiệu: Ép máy chủ nhận lệnh liên tục
            fireproximityprompt(prompt, 0)
            fireproximityprompt(prompt, 1)
            fireproximityprompt(prompt)
        end
        
        -- Loại bỏ hoàn toàn task.wait() ở đây để không tạo độ trễ
        prompt:InputHoldBegin()
        prompt:InputHoldEnd()
    end
end

function GetVolcanicSafePos(eggPos, targetObj)
    local rayOrigin = Vector3.new(eggPos.X, 3000, eggPos.Z)
    local rayDirection = Vector3.new(0, -4000, 0)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, targetObj}
    local result = Workspace:Raycast(rayOrigin, rayDirection, params)
    if result then return result.Position + Vector3.new(0, 15, 0) end
    return eggPos + Vector3.new(0, 200, 0) 
end

task.spawn(function()
    task.wait(2) 
    while task.wait(0.1) do 
        if not isHopping then
            if Settings.AutoFarm and not CustomBasePos then
                CustomBasePos = AutoDetectBase() or Vector3.new(0, 50, 0)
            end

            if Settings.AutoFarm and CustomBasePos then
                local targetObj, targetName = nil, ""
                
                if #Settings.SelectedEggs == 0 then
                    CurrentStatus = "Chưa chọn trứng mục tiêu!"
                    StatusLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
                else
                    for _, pEgg in ipairs(PriorityOrder) do
                        if table.find(Settings.SelectedEggs, pEgg) then
                            for obj, data in pairs(ESP_Cache) do
                                if data.Name == pEgg then
                                    if IsEggValid(obj) then targetObj = obj; targetName = pEgg; break
                                    else ESP_Cache[obj] = nil end
                                end
                            end
                        end
                        if targetObj then break end
                    end

                    if targetObj then
                        CurrentStatus = "Đang lấy: " .. targetName
                        StatusLbl.TextColor3 = TargetEggs[targetName] or Color3.fromRGB(255, 255, 0)

                        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local eggPos = targetObj:IsA("Model") and (targetObj.PrimaryPart and targetObj.PrimaryPart.Position or targetObj:GetPivot().Position) or targetObj:IsA("BasePart") and targetObj.Position
                            if eggPos then
                                if targetName == "Volcanic Egg" then
                                    hrp.CFrame = CFrame.new(GetVolcanicSafePos(eggPos, targetObj))
                                    task.wait(0.01) -- Rút ngắn tối đa
                                    local twn = TweenService:Create(hrp, TweenInfo.new(math.max(0.02, (hrp.Position - (eggPos + Vector3.new(0, 2.5, 0))).Magnitude / Settings.FlySpeed), Enum.EasingStyle.Linear), {CFrame = CFrame.new(eggPos + Vector3.new(0, 2.5, 0))})
                                    twn:Play()
                                    while twn.PlaybackState == Enum.PlaybackState.Playing and IsEggValid(targetObj) do
                                        FastInteract(targetObj)
                                        task.wait() -- Chờ bằng thời gian 1 khung hình (~0.015s)
                                    end
                                    if twn.PlaybackState == Enum.PlaybackState.Playing then twn:Cancel() end
                                else
                                    hrp.CFrame = CFrame.new(eggPos + Vector3.new(0, 2.5, 0))
                                    task.wait(0.01) -- Đợi nhân vật tải vị trí cực ngắn
                                end
                                
                                -- Ép tương tác tốc độ cao
                                local attempts = 0
                                while IsEggValid(targetObj) and attempts < 30 do -- Tăng số lần giới hạn vì vòng lặp chạy quá nhanh
                                    FastInteract(targetObj)
                                    task.wait() -- Lặp tốc độ khung hình
                                    attempts = attempts + 1
                                end
                                
                                if not IsEggValid(targetObj) then
                                    SessionCollected[targetName] = SessionCollected[targetName] + 1
                                end

                                FastTween(CFrame.new(CustomBasePos + Vector3.new(0, 5, 0)))
                                task.wait(0.05) -- Quay về căn cứ nhanh hơn
                            end
                        end
                    else
                        if Settings.AutoHop then HopServer() else
                            CurrentStatus = "Đợi trứng spawn..."
                            StatusLbl.TextColor3 = Color3.fromRGB(150, 150, 150)
                        end
                    end
                end
            else
                CurrentStatus = "Đang nhàn rỗi (AutoFarm OFF)"
                StatusLbl.TextColor3 = Color3.fromRGB(150, 150, 150)
            end
        end
    end
end)

