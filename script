RunService.RenderStepped:Connect(function()
    if Settings.AutoFarm then
        if not CustomBasePos then CustomBasePos = AutoDetectBase() end
        local targetObj = nil
        
        for _, pEgg in ipairs(PriorityOrder) do
            if table.find(Settings.SelectedEggs, pEgg) then
                for obj, data in pairs(ESP_Cache) do
                    if data.Name == pEgg and IsEggValid(obj) then 
                        targetObj = obj; break
                    elseif not IsEggValid(obj) then 
